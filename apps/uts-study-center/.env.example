# Local SQLite database. Keep this path server-side.
DATABASE_URL="file:./data/uts-study-center.db"

# Canvas is optional. Without a token the application uses realistic mock data.
CANVAS_BASE_URL="https://canvas.uts.edu.au"
CANVAS_ALLOWED_HOSTS="canvas.uts.edu.au"
CANVAS_ACCESS_TOKEN=""

# Reserved for the future AI provider. The MVP remains usable when these are empty.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Optional 32-byte base64 key for encrypted credential storage in a packaged version.
CREDENTIAL_ENCRYPTION_KEY=""
